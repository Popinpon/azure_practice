# scripts/ 配下のPythonスクリプトが読む設定。
# コピーして scripts/.env として保存する(gitignore対象、*.envで除外済み)。
#   cd scripts && cp .env.example .env

# MCPサーバーのエンドポイント。terraform variables.tf の mcp_server_url と同じ値。
# get-oauth-endpoints.py はここからPRM URLを自動で組み立てる。
TF_VAR_mcp_server_url=https://<mcpサーバーのホスト名>/mcp

# AI Foundryアカウントのエンドポイント (terraform output ai_foundry_endpoint)
FOUNDRY_ENDPOINT=https://<foundry-account>.services.ai.azure.com/

# Foundryプロジェクト名。未指定ならclosed-project (terraformのbase_name-projectの既定値)
FOUNDRY_PROJECT=closed-project

# デプロイ済みモデル名。未指定ならgpt-6-luna (variables.tf の model_name の既定値)
FOUNDRY_MODEL=gpt-6-luna

# 作成/更新するAgent名。未指定ならmcp-verify-agent
# FOUNDRY_AGENT_NAME=mcp-verify-agent

# mcpツールの任意の識別名 (server_label)
MCP_SERVER_LABEL=<server_label>

# Foundry Portalの対象ツール詳細画面(Build → 接続したツールを開く)の
# 「プロジェクト接続 ID」欄に表示されているARMリソースID
# (/subscriptions/.../connections/<connection名> という形式。短い名前だけではない)
MCP_CONNECTION_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project>/connections/<connection名>

# 認可後の再実行で使う。1回目の実行結果に表示されたresponse idを貼る
# FOUNDRY_PREVIOUS_RESPONSE_ID=resp_...
